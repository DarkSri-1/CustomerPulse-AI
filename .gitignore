# Virtual Environment
.venv/
venv/
ENV/

# Environment variables and secrets (NEVER COMMIT)
.env

# Python cache and bytecode
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ipynb_checkpoints/
.coverage
htmlcov/

# Logs
logs/*
!logs/.gitkeep

# Data files (ignore heavy Excel/CSV datasets, keep folder structure)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Trained model binaries (keep metadata JSON if desired, ignore heavy binaries)
models/*.joblib
models/*.pkl
!models/.gitkeep

# OS & IDE files
.DS_Store
Thumbs.db
